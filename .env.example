# Copy to .env and fill in. The foundation runs fully offline with the
# default deterministic embedder -- only DATABASE_URL is required.

DATABASE_URL=postgresql://localhost:5432/memlayer

# Embedding provider: "local" (default, offline, deterministic) | "voyage" | "openai"
EMBED_PROVIDER=local

# Only needed if EMBED_PROVIDER is a real provider.
# VOYAGE_API_KEY=
# OPENAI_API_KEY=
